{
  "name": "musashi-drill",
  "version": "0.1.0",
  "private": true,
  "description": "教習所ソフト「武蔵」方式の暗記学習エンジン。全問固定周回＋迷ったフラグ＋オフラインPWA。",
  "type": "module",
  "scripts": {
    "build-data": "node scripts/build-data.mjs",
    "dev": "npm run build-data && vite",
    "build": "npm run build-data && vite build",
    "preview": "vite preview --host",
    "deploy": "npm run build && wrangler pages deploy dist --project-name=musashi-drill"
  },
  "devDependencies": {
    "js-yaml": "^4.1.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^0.20.5",
    "wrangler": "^4.0.0"
  }
}
